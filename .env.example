# ===== 应用 =====
# 复制本文件为 .env 后按需修改；.env 已在 .gitignore 中，绝不入库。
APP_NAME=ai-commerce-platform
ENV=dev
DEBUG=true

# ===== 安全 =====
# JWT_SECRET_KEY 为必填（无默认值）：未配置时应用启动即报错，防止用公开默认值伪造 token。
# 请用强随机值：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-please-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
# 生产环境走 HTTPS 时必须设为 true，否则会话 cookie 明文传输可被窃听
COOKIE_SECURE=false

# ===== 数据库（Postgres）=====
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=commerce

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== LLM（Anthropic，支持自定义 base_url / auth_token）=====
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-6
# LLM 请求超时（秒）：上游卡住时终止请求，避免 SSE 无限挂起
LLM_TIMEOUT_SECONDS=60

# ===== RAG（Qdrant + fastembed）=====
QDRANT_URL=http://127.0.0.1:6333
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh
RAG_TOP_K=6
RAG_COLLECTION=knowledge_base
# HuggingFace 下载镜像（国内网络不可直连 hf.co 时设置）
HF_ENDPOINT=
# 禁用 Xet 协议（huggingface_hub>=1.x 读 HF_HUB_DISABLE_XET；旧版读 HF_DISABLE_XET）。
# 走镜像下载时 Xet CAS 会 401，务必设为 true。
HF_HUB_DISABLE_XET=false
HF_DISABLE_XET=false

# ===== 可观测（Langfuse，可插拔；不可用时降级为日志+指标）=====
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000

# ===== 限流（次/分钟/键）=====
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_CHAT=20
